# 商境生产部署环境变量模板。
# 复制到 /opt/shangjing-app/.env.app（权限 600，属主 root），填入真实值后不要提交。
# 本文件只有变量名与说明，不含任何真实凭据。
# 注意：仓库根 .gitignore 忽略 .env.*，仅本模板例外。

# ---- 应用与访问控制 ----
# 容器内监听端口，与 compose.yaml 的端口映射保持一致。
PORT=4173
# 浏览器地址栏中的 Host 白名单（含端口）。nginx 使用 $http_host 保留端口。
# 部署后按实际访问地址填写，多个用英文逗号分隔，例如：
#   <公网IP>:8443,<备用公网IP>:8443
SJ_ALLOWED_HOSTS=
# 允许的浏览器 Origin，与访问地址一致，例如 https://<公网IP>:8443
SJ_PUBLIC_ORIGIN=
# 开启账号登录（React 登录页、三角色鉴权）。生产必须为 on。
SJ_AUTH=on

# ---- PostgreSQL（现有中间件，必须 TLS） ----
PGHOST=
PGPORT=5432
PGDATABASE=shangjing
PGUSER=shangjing_app
PGPASSWORD=
PGSSLMODE=verify-full
# 容器内 CA 路径，compose 已把宿主 CA 只读挂载到这里。
PGSSLROOTCERT=/run/shangjing/ca.crt
# 与 PG* 等价的完整连接串；服务端当前读取 PG*，保留供工具与后续使用。
# 不要把证书路径或真实密码写进提交文件。
DATABASE_URL=

# ---- MinIO（现有中间件，HTTPS + 项目 CA） ----
MINIO_ENDPOINT=https://203.0.113.10:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=shangjing_app
MINIO_SECRET_KEY=
MINIO_BUCKET_ASSETS=shangjing-assets
MINIO_BUCKET_EXPORTS=shangjing-exports

# ---- 项目私有 CA ----
# 宿主上的 CA 公共证书路径，compose 用它做只读 bind mount。
MIDDLEWARE_CA_HOST_PATH=/opt/shangjing-app/tls/authority/ca.crt
# 容器内 CA 路径，应用读取它校验 PostgreSQL/MinIO。
MIDDLEWARE_CA_CERT=/run/shangjing/ca.crt
# 让 Node 出站 HTTPS 也默认信任项目 CA（OMYAI 等公共站点仍用公共 CA）。
NODE_EXTRA_CA_CERTS=/run/shangjing/ca.crt

# ---- 模型供应商 ----
# OMYAI 生图密钥；只放在本文件，不要写进前端、config/providers.json 或日志。
OMYAI_API_KEY=
# DeepSeek 文本模型密钥（用于商品聊天和 AI 规划的初始默认模型）。
DEEPSEEK_API_KEY=
# 优云智算 MiniMax H3 视频接口，首次启动加密保存到渠道表。
MINIMAX_H3_API_KEY=
# 仅旧执行器兼容变量；创作 v2 使用带 DNS 校验的直连 HTTPS，不读取此代理。
MODEL_HTTPS_PROXY=
# 渠道加密主密钥（32 字节 base64）。强烈建议显式提供并与数据库一起备份；
# 留空时首次启动会在命名卷 shangjing-app-secrets 中自动生成。
# 丢失后系统页新增渠道的密钥无法恢复。
CHANNEL_ENCRYPTION_KEY=

# ---- Compose 构建/运行参数（--env-file 读取，不传给应用逻辑） ----
# 镜像标签；回滚时改成旧标签再 up -d。
APP_IMAGE_TAG=latest
# 由 deploy.sh 自动导出，通常不用手填：
# APP_ENV_FILE=/opt/shangjing-app/.env.app
# APP_SOURCE_DIR=<仓库根目录绝对路径>
# MIDDLEWARE_CA_HOST_PATH 同时用于 compose 的 bind mount。
