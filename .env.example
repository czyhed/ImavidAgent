# 实际已生成配置在 .env.middleware.local；该文件与 .secrets/ 均不提交 Git。
# 所有服务使用 TLS，必须加载项目 CA。这里没有真实密码。
PGHOST=203.0.113.10
PGPORT=5432
PGDATABASE=shangjing
PGUSER=shangjing_app
PGPASSWORD=REPLACE_WITH_LOCAL_SECRET
PGSSLMODE=verify-full
PGSSLROOTCERT=REPLACE_WITH_ABSOLUTE_CA_PATH
DATABASE_URL=postgresql://shangjing_app:REPLACE_WITH_LOCAL_SECRET@203.0.113.10:5432/shangjing?sslmode=verify-full
REDIS_URL=rediss://shangjing_app:REPLACE_WITH_LOCAL_SECRET@203.0.113.10:6379/0
REDIS_USERNAME=shangjing_app
REDIS_PASSWORD=REPLACE_WITH_LOCAL_SECRET
REDIS_KEY_PREFIX=sj:
MIDDLEWARE_CA_CERT=REPLACE_WITH_ABSOLUTE_CA_PATH
NODE_EXTRA_CA_CERTS=REPLACE_WITH_ABSOLUTE_CA_PATH
MINIO_ENDPOINT=https://203.0.113.10:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=shangjing_app
MINIO_SECRET_KEY=REPLACE_WITH_LOCAL_SECRET
MINIO_BUCKET_ASSETS=shangjing-assets
MINIO_BUCKET_EXPORTS=shangjing-exports

# 单独放在 Git 忽略的 .env.models.local；不得写入前端或 providers.json。
# OMYAI 官方 OpenAI 标准渠道（omyai-openai）与历史 MCP 渠道共用此密钥。
OMYAI_API_KEY=REPLACE_WITH_LOCAL_SECRET
# 文本模型（DeepSeek 官方 API），供 AI 规划、提示词等 text.chat 能力使用；执行器尚未接入。
DEEPSEEK_API_KEY=REPLACE_WITH_LOCAL_SECRET
# 可选：系统页新增渠道的加密主密钥（32 字节 base64）。不填则首次启动自动生成
# .secrets/channel-encryption.key；该文件必须与数据库一起安全备份，丢失后已保存的渠道密钥无法恢复。
CHANNEL_ENCRYPTION_KEY=
# 可选：本机网络需要代理时填写 HTTP 代理 URL；直连环境留空。
MODEL_HTTPS_PROXY=
# 本地服务仅绑定 127.0.0.1，尚未提供多用户鉴权。
PORT=4173
